{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["jest", "react", "react-native", "node"]
  },
  "include": ["src", "app", "index.js"],
  "exclude": [
    "android",
    "ios",
    "node_modules",
    "coverage",
    "components",
    "src/__tests__/**"
  ],
  "extends": "expo/tsconfig.base"
}
