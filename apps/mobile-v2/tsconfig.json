{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "app", "index.js"],
  "exclude": [
    "android",
    "ios",
    "node_modules",
    "coverage",
    "components",
    "src/__tests__/**"
  ]
}
